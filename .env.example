# The real, live AMARA widget script (the same one real businesses embed)
NEXT_PUBLIC_AMARA_WIDGET_URL=https://datacrux-admin.vercel.app/widget.js

# Your real backend
NEXT_PUBLIC_AMARA_API_URL=https://datacrux-backend-production.up.railway.app

# The API key of a dedicated showcase business - see HOW_TO_APPLY.md for
# how to create one. Never use a real client's key here.
NEXT_PUBLIC_AMARA_DEMO_API_KEY=

# Same Resend account already used by the backend - just reuse that
# RESEND_API_KEY value here.
RESEND_API_KEY=

# Where contact form submissions get emailed
CONTACT_EMAIL_TO=datacruxafrica@gmail.com

# Optional - only needed once you've verified your own domain in Resend
NOTIFICATIONS_FROM_EMAIL=
